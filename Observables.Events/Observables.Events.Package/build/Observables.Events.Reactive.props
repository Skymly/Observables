<Project>
  <PropertyGroup>
    <ObservableRoutedEvents Condition="'$(ObservableRoutedEvents)' == ''">false</ObservableRoutedEvents>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservableRoutedEvents" />
    <CompilerVisibleProperty Include="UseWPF" />
  </ItemGroup>
</Project>
