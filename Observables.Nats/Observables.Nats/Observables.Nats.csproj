<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Observables.Nats</RootNamespace>
    <AssemblyName>Observables.Nats</AssemblyName>
    <Description>NATS client runtime and R3 stream bridges.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- NATS.Client.Core pulls VisualStudio.Threading analyzers; R3AsyncCreate uses async void on purpose. -->
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD200</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\eng\NetStandard20.props" Condition="Exists('..\..\eng\NetStandard20.props')" />

  <ItemGroup>
    <InternalsVisibleTo Include="Observables.Nats.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NATS.Client.Core" />
    <PackageReference Include="NATS.Client.Serializers.Json" />
    <PackageReference Include="R3" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="..\..\Observables.Shared\Observables.Core\GeneratedProxyFactoryRegistry.cs" Link="Shared/GeneratedProxyFactoryRegistry.cs" />
    <Compile Include="..\..\Observables.Shared\Observables.R3.Runtime\R3AsyncCreate.cs" Link="Shared/R3AsyncCreate.cs" />
  </ItemGroup>
</Project>
