<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesSignalRBackend_R3). -->
  <PropertyGroup>
    <ObservablesSignalRBackend_R3>true</ObservablesSignalRBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesSignalRBackend_R3" />
  </ItemGroup>
</Project>
