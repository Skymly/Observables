<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\eng\Observables.Package.props" />

  <PropertyGroup>
    <PackageId>Observables.Mqtt.MQTTnet5</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>MQTTnet 5 transport for Observables MQTT proxies.</Description>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Observables.Mqtt\Observables.Mqtt.csproj" />
    <PackageReference Include="MQTTnet" />
    <None Include="..\Observables.Mqtt.Package\README.Mqtt.Transport.pack.md" Pack="true" PackagePath="README.md" />
    <Compile Include="..\Observables.Mqtt.MQTTnet4\MqttNetTransport.cs" Link="MqttNetTransport.cs" />
  </ItemGroup>

</Project>
