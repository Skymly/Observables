<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesWebSocketBackend_R3). -->
  <PropertyGroup>
    <ObservablesWebSocketBackend_R3>true</ObservablesWebSocketBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesWebSocketBackend_R3" />
  </ItemGroup>
</Project>
