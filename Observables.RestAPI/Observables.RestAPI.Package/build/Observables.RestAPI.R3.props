<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesRestAPIBackend_R3). -->
  <PropertyGroup>
    <ObservablesRestAPIBackend_R3>true</ObservablesRestAPIBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesRestAPIBackend_R3" />
  </ItemGroup>
</Project>
