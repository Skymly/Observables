<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesGrpcBackend_R3). -->
  <PropertyGroup>
    <ObservablesGrpcBackend_R3>true</ObservablesGrpcBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesGrpcBackend_R3" />
  </ItemGroup>
</Project>
