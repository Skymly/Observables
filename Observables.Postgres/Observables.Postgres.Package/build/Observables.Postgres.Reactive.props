<Project>
  <!-- Declares the Reactive backend for OBS0001 conflict detection (build_property.ObservablesPostgresBackend_Reactive). -->
  <PropertyGroup>
    <ObservablesPostgresBackend_Reactive>true</ObservablesPostgresBackend_Reactive>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesPostgresBackend_Reactive" />
  </ItemGroup>
</Project>
