<Project>

  <!--
    Shared source files for all Observables source generators.
    Import this props file to link-compile the shared infrastructure without
    referencing Observables.SourceGenerators.Shared as an analyzer dependency.
  -->

  <ItemGroup>
    <!-- Core utilities -->
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/SourceWriter.cs">
      <Link>Shared/SourceWriter.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/ImmutableEquatableArray.cs">
      <Link>Shared/ImmutableEquatableArray.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/IsExternalInit.cs">
      <Link>Shared/IsExternalInit.cs</Link>
    </Compile>

    <!-- Existing shared infrastructure (already in Observables.SourceGenerators.Shared namespace) -->
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/GeneratedSourceHeader.cs">
      <Link>Shared/GeneratedSourceHeader.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/Extensions/INamedTypeSymbolExtensions.cs">
      <Link>Shared/Extensions/INamedTypeSymbolExtensions.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/Diagnostics/ObservableReturnTypeParser.cs">
      <Link>Shared/Diagnostics/ObservableReturnTypeParser.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/Nullability.cs">
      <Link>Shared/Nullability.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/IncrementalValuesProviderExtensions.cs">
      <Link>Shared/IncrementalValuesProviderExtensions.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/IdentifierHelper.cs">
      <Link>Shared/IdentifierHelper.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/BackendTokens.cs">
      <Link>Shared/BackendTokens.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/GeneratorFailSafe.cs">
      <Link>Shared/GeneratorFailSafe.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/DiagnosticHelpLink.cs">
      <Link>Shared/DiagnosticHelpLink.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/ProxyRegistrationEmitter.cs">
      <Link>Shared/ProxyRegistrationEmitter.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/ProxyClassEmitter.cs">
      <Link>Shared/ProxyClassEmitter.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/IoProxyGeneratorPipeline.cs">
      <Link>Shared/IoProxyGeneratorPipeline.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/IoProxyInterfaceWalk.cs">
      <Link>Shared/IoProxyInterfaceWalk.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.SourceGenerators.Shared/IoProxyModelAssembly.cs">
      <Link>Shared/IoProxyModelAssembly.cs</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)Observables.Shared/Observables.Roslyn.Shared/ProxyDomainTable.cs">
      <Link>Shared/ProxyDomainTable.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- Global using to avoid qualifying shared types -->
  <ItemGroup>
    <Using Include="Observables.SourceGenerators.Shared" />
  </ItemGroup>

</Project>
