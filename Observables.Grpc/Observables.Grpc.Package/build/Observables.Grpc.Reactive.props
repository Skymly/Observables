<Project>
  <!-- Declares the Reactive backend for OBS0001 conflict detection (build_property.ObservablesGrpcBackend_Reactive). -->
  <PropertyGroup>
    <ObservablesGrpcBackend_Reactive>true</ObservablesGrpcBackend_Reactive>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesGrpcBackend_Reactive" />
  </ItemGroup>
</Project>
