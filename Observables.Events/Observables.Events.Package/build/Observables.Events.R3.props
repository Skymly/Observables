<Project>
  <PropertyGroup>
    <ObservableRoutedEvents Condition="'$(ObservableRoutedEvents)' == ''">false</ObservableRoutedEvents>
    <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesEventsBackend_R3). -->
    <ObservablesEventsBackend_R3>true</ObservablesEventsBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservableRoutedEvents" />
    <CompilerVisibleProperty Include="UseWPF" />
    <CompilerVisibleProperty Include="ObservablesEventsBackend_R3" />
  </ItemGroup>
</Project>
