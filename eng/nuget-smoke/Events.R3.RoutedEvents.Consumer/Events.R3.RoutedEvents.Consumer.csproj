<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ObservableRoutedEvents>true</ObservableRoutedEvents>
    <DefineConstants>$(DefineConstants);EVENTS_R3</DefineConstants>
    <RootNamespace>Observables.NuGetSmoke.Events.R3.RoutedEvents</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Observables.Events.R3" Version="$(ObservablesConsumerPackageVersion)" />
  </ItemGroup>
</Project>
