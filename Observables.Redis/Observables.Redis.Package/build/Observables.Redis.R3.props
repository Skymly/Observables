<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesRedisBackend_R3). -->
  <PropertyGroup>
    <ObservablesRedisBackend_R3>true</ObservablesRedisBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesRedisBackend_R3" />
  </ItemGroup>
</Project>
