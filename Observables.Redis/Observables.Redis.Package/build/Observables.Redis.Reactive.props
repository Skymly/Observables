<Project>
  <!-- Declares the Reactive backend for OBS0001 conflict detection (build_property.ObservablesRedisBackend_Reactive). -->
  <PropertyGroup>
    <ObservablesRedisBackend_Reactive>true</ObservablesRedisBackend_Reactive>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesRedisBackend_Reactive" />
  </ItemGroup>
</Project>
