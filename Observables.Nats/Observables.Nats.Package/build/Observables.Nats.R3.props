<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesNatsBackend_R3). -->
  <PropertyGroup>
    <ObservablesNatsBackend_R3>true</ObservablesNatsBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesNatsBackend_R3" />
  </ItemGroup>
</Project>
