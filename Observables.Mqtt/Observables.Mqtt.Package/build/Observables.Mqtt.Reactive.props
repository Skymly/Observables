<Project>
  <!-- Declares the Reactive backend for OBS0001 conflict detection (build_property.ObservablesMqttBackend_Reactive). -->
  <PropertyGroup>
    <ObservablesMqttBackend_Reactive>true</ObservablesMqttBackend_Reactive>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesMqttBackend_Reactive" />
  </ItemGroup>
</Project>
