<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ObservableRoutedEvents>true</ObservableRoutedEvents>
    <RootNamespace>Observables.NuGetSmoke.Events.R3.RoutedEvents</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Observables.Events.R3" Version="$(ObservablesConsumerPackageVersion)" />
    <PackageReference Include="R3" Version="1.3.0" />
  </ItemGroup>
</Project>
