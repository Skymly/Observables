<Project>
  <!-- Declares the Reactive backend for OBS0001 conflict detection (build_property.ObservablesSignalRBackend_Reactive). -->
  <PropertyGroup>
    <ObservablesSignalRBackend_Reactive>true</ObservablesSignalRBackend_Reactive>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesSignalRBackend_Reactive" />
  </ItemGroup>
</Project>
