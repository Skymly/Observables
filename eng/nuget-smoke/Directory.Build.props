<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireObservablesConsumerPackageVersion" BeforeTargets="CollectPackageReferences;Restore">
    <Error Condition="'$(ObservablesConsumerPackageVersion)' == ''"
           Text="Set ObservablesConsumerPackageVersion (Nuke NuGetConsumerSmoke injects PackageVersion from eng/Observables.Package.props)." />
  </Target>
</Project>
