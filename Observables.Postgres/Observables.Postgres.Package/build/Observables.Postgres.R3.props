<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesPostgresBackend_R3). -->
  <PropertyGroup>
    <ObservablesPostgresBackend_R3>true</ObservablesPostgresBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesPostgresBackend_R3" />
  </ItemGroup>
</Project>
