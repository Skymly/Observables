<Project>
  <!-- Declares the Reactive backend for OBS0001 conflict detection (build_property.ObservablesRestAPIBackend_Reactive). -->
  <PropertyGroup>
    <ObservablesRestAPIBackend_Reactive>true</ObservablesRestAPIBackend_Reactive>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesRestAPIBackend_Reactive" />
  </ItemGroup>
</Project>
