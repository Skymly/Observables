<Project>
  <!-- Declares the R3 backend for OBS0001 conflict detection (build_property.ObservablesSseBackend_R3). -->
  <PropertyGroup>
    <ObservablesSseBackend_R3>true</ObservablesSseBackend_R3>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ObservablesSseBackend_R3" />
  </ItemGroup>
</Project>
